{
  "name": "flowith-web-account-manager",
  "private": true,
  "version": "0.0.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && node scripts/package-dir.mjs",
    "dist:win": "npm run build && node scripts/package-dir.mjs --platform=win32",
    "dist:linux": "npm run build && node scripts/package-dir.mjs --platform=linux",
    "dist:mac": "npm run build && node scripts/package-dir.mjs --platform=darwin",
    "preview": "electron-vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.0",
    "electron-store": "^11.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^40.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pngjs": "^7.0.0",
    "rcedit": "^4.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
